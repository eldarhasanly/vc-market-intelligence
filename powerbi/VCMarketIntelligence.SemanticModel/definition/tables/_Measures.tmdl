table _Measures
	lineageTag: 1e1beda2-1ca6-46c6-a4fc-80565419c99d

	measure 'OECD VC Investment (USD M)' = SUM(FactOECDVCTotal[vc_investment_usd_millions])
		formatString: 0.00
		lineageTag: e8b5d271-8862-446d-9f1c-80fb1aa73db8

	measure 'OECD VC Investment (USD B)' = DIVIDE ([OECD VC Investment (USD M)], 1000)
		formatString: 0.00
		lineageTag: b374096d-4746-4ec5-8539-680a9ca6aa5f

	measure 'OECD VC YoY Growth (%)' =
			
			VAR CurrentYear =
			    SELECTEDVALUE ( DimYear[year] )
			
			VAR CurrentInvestment = [OECD VC Investment (USD M)]
			
			VAR PreviousInvestment =
			    CALCULATE (
			        [OECD VC Investment (USD M)],
			        REMOVEFILTERS ( DimYear ),
			        DimYear[year] = CurrentYear - 1
			    )
			
			RETURN
			    IF (
			        ISBLANK ( CurrentYear )
			            || ISBLANK ( CurrentInvestment )
			            || ISBLANK ( PreviousInvestment ),
			        BLANK (),
			        DIVIDE (
			            CurrentInvestment - PreviousInvestment,
			            PreviousInvestment
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cee796a3-a032-42a5-8f6d-62f8f86bad4f

	measure 'OECD Stage Investment (USD M)' = SUM(FactOECDVCStage[vc_investment_usd_millions])
		formatString: 0.00
		lineageTag: 1dba2174-3a6e-4e4a-a690-acb6c9bc9e01

	measure 'OECD Stage Investment (USD B)' = DIVIDE([OECD Stage Investment (USD M)], 1000)
		formatString: 0.00
		lineageTag: 92c88e23-39bf-490f-9b9e-52059b74c128

	measure 'OECD Stage Share (%)' =
			
			DIVIDE (
			    [OECD Stage Investment (USD M)],
			    CALCULATE (
			        [OECD Stage Investment (USD M)],
			        REMOVEFILTERS ( DimOECDStage )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 38e4f685-a1f7-44b9-9ef2-47536c34c2e0

	measure 'Private AI Investment (2021 USD B)' =
			
			CALCULATE (
			    SUM ( FactOWIDPrivateAI[value_usd_bn_2021_prices] ),
			    FactOWIDPrivateAI[metric] = "private_ai_investment"
			)
		formatString: 0.00
		lineageTag: 2e95421e-be50-4f21-8311-dc0cbe6cbab5

	measure 'Private GenAI Investment (2021 USD B)' =
			
			CALCULATE (
			    SUM ( FactOWIDPrivateAI[value_usd_bn_2021_prices] ),
			    FactOWIDPrivateAI[metric] = "private_genai_investment"
			)
		formatString: 0.00
		lineageTag: 462a9ddc-f00d-438a-b98c-d7b211352114

	measure 'GenAI Share of Private AI (%)' =
			
			DIVIDE (
			    [Private GenAI Investment (2021 USD B)],
			    [Private AI Investment (2021 USD B)]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9a27ed15-9849-4e8b-a7a0-5f8d2ce7b00d

	measure 'OECD AI VC Investment (USD B)' =
			
			IF (
			    HASONEVALUE ( DimYear[year] ),
			    CALCULATE (
			        MAX ( FactOECDAIBenchmarks[value] ),
			        FactOECDAIBenchmarks[metric] = "ai_vc",
			        FactOECDAIBenchmarks[geography] = "World"
			    )
			)
		formatString: 0.00
		lineageTag: 12cb6cf5-2dae-425a-981a-77993818d133

	measure 'OECD GenAI VC Investment (USD B)' =
			
			IF (
			    HASONEVALUE ( DimYear[year] ),
			    CALCULATE (
			        MAX ( FactOECDAIBenchmarks[value] ),
			        FactOECDAIBenchmarks[metric] = "genai_vc",
			        FactOECDAIBenchmarks[geography] = "World"
			    )
			)
		formatString: 0.00
		lineageTag: ac6b7bbb-1380-46d7-88d7-0fcf8da4b941

	measure 'OECD AI Share of Global VC (%)' =
			
			IF (
			    HASONEVALUE ( DimYear[year] ),
			    DIVIDE (
			        CALCULATE (
			            MAX ( FactOECDAIBenchmarks[value] ),
			            FactOECDAIBenchmarks[metric] = "ai_share_of_total_vc",
			            FactOECDAIBenchmarks[geography] = "World"
			        ),
			        100
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1bc6c686-5975-4de3-982d-51c337f51101

	measure 'OECD AI Mega-Deal Share (%)' =
			
			IF (
			    HASONEVALUE ( DimYear[year] ),
			    DIVIDE (
			        CALCULATE (
			            MAX ( FactOECDAIBenchmarks[value] ),
			            FactOECDAIBenchmarks[metric] = "ai_mega_deal_share_of_ai_vc",
			            FactOECDAIBenchmarks[geography] = "World"
			        ),
			        100
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ddbf021d-0e86-45d9-80f5-ce4f89f79830

	measure 'EdTech VC Investment (USD B)' = SUM(FactEdTechMarket[edtech_vc_usd_billions])
		formatString: 0.00
		lineageTag: 01ddf393-c87e-4fac-b2e4-ad08f77eaaab

	measure 'EdTech VC YoY Growth (%)' =
			
			VAR CurrentYear =
			    SELECTEDVALUE ( DimYear[year] )
			
			VAR CurrentInvestment =
			    [EdTech VC Investment (USD B)]
			
			VAR PreviousInvestment =
			    CALCULATE (
			        [EdTech VC Investment (USD B)],
			        REMOVEFILTERS ( DimYear ),
			        DimYear[year] = CurrentYear - 1
			    )
			
			RETURN
			    IF (
			        ISBLANK ( CurrentYear )
			            || ISBLANK ( CurrentInvestment )
			            || ISBLANK ( PreviousInvestment ),
			        BLANK (),
			        DIVIDE (
			            CurrentInvestment - PreviousInvestment,
			            PreviousInvestment
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: caefdeb3-57d9-4e01-9711-687d0ac12a1f

	measure 'Curated EdTech Funding (USD M)' = SUM(FactEdTechRounds[round_amount_usd_millions])
		formatString: 0.00
		lineageTag: 4fd0741d-e1dd-4e64-9df5-1d650e54dae1

	measure 'Curated EdTech Round Count' = COUNTROWS(FactEdTechRounds)
		formatString: 0
		lineageTag: 430c8711-c5d8-417e-9df3-2691243ac1ed

	measure 'Curated EdTech Company Count' = DISTINCTCOUNT(FactEdTechRounds[company_id])
		formatString: 0
		lineageTag: 8093e1c7-1eeb-4c26-bb68-201b157caa1c

	measure 'Pre-GPT Average Annual VC (USD B)' =
			
			VAR PreGPTInvestment = CALCULATE([OECD VC Investment (USD B)], REMOVEFILTERS(DimYear), DimYear[year] >= 2019, DimYear[year] <= 2021)
			RETURN DIVIDE (PreGPTInvestment, 3)
		formatString: 0.00
		lineageTag: 011311b7-88ba-4add-8936-1a574b235f21

	measure 'Post-GPT Average Annual VC (USD B)' =
			
			VAR PostGPTInvestment = CALCULATE([OECD VC Investment (USD B)], REMOVEFILTERS(DimYear), DimYear[year] >= 2023, DimYear[year] <= 2025)
			RETURN DIVIDE (PostGPTInvestment, 3)
		formatString: 0.00
		lineageTag: 85faeca6-9a31-454b-9525-6896b17980fc

	measure 'Post-GPT VC Change (%)' = DIVIDE ([Post-GPT Average Annual VC (USD B)] - [Pre-GPT Average Annual VC (USD B)], [Pre-GPT Average Annual VC (USD B)])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c529c9ef-6d69-44af-8119-b27729559aa4

	measure 'VC Regime Color' =
			
			VAR SelectedYear =
			    SELECTEDVALUE ( DimYear[year] )
			RETURN
			    SWITCH (
			        TRUE (),
			        SelectedYear >= 2019 && SelectedYear <= 2021, "#64748B",
			        SelectedYear = 2022, "#A7B0BF",
			        SelectedYear >= 2023 && SelectedYear <= 2025, "#2251FF",
			        "#E2E8F0"
			    )
		lineageTag: fa795e76-abd9-4fa7-8ccf-032ad9401752

	measure 'OECD Reporting Country Count' = DISTINCTCOUNT(FactOECDVCTotal[country_code])
		formatString: 0
		lineageTag: 8dfbef33-47ad-4aa1-afe3-f860c8474033

	measure 'OECD Country VC Share (%)' = DIVIDE([OECD VC Investment (USD B)], CALCULATE([OECD VC Investment (USD B)], REMOVEFILTERS(DimOECDCountry)))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3b4e1a04-576f-4537-b2ea-710dbfb4096c

	measure 'OECD Top 10 VC Share (%)' =
			
			VAR CountryAmounts =
			    ADDCOLUMNS (
			        ALL ( DimOECDCountry ),
			        "@Investment",
			            CALCULATE (
			                [OECD VC Investment (USD B)]
			            )
			    )
			VAR TopTen =
			    TOPN (
			        10,
			        FILTER (
			            CountryAmounts,
			            NOT ISBLANK ( [@Investment] )
			        ),
			        [@Investment], DESC,
			        DimOECDCountry[country_code], ASC
			    )
			VAR TopTenInvestment =
			    SUMX ( TopTen, [@Investment] )
			VAR TotalInvestment =
			    CALCULATE (
			        [OECD VC Investment (USD B)],
			        REMOVEFILTERS ( DimOECDCountry )
			    )
			RETURN
			    DIVIDE (
			        TopTenInvestment,
			        TotalInvestment
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b191d7ce-3479-4e4f-b37d-93bd52d58154

	measure 'OECD VC 2023 (USD B)' =
			
			CALCULATE (
			    [OECD VC Investment (USD B)],
			    REMOVEFILTERS ( DimYear ),
			    DimYear[year] = 2023
			)
		formatString: 0.00
		lineageTag: a11a9b09-d6c7-47af-9184-2fae70524c0e

	measure 'OECD VC 2025 (USD B)' =
			
			CALCULATE (
			    [OECD VC Investment (USD B)],
			    REMOVEFILTERS ( DimYear ),
			    DimYear[year] = 2025
			)
		formatString: 0.00
		lineageTag: 5839b7fb-001a-4c23-b0d8-ef29d6e3c98e

	measure 'OECD VC Recovery 2023-2025 (%)' =
			
			VAR Investment2023 =
			    [OECD VC 2023 (USD B)]
			VAR Investment2025 =
			    [OECD VC 2025 (USD B)]
			RETURN
			    IF (
			        NOT ISBLANK ( Investment2023 )
			            && Investment2023 > 0
			            && NOT ISBLANK ( Investment2025 ),
			        DIVIDE (
			            Investment2025 - Investment2023,
			            Investment2023
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2e391511-3991-49e0-9e86-7c9daa8eaea8

	measure 'OECD Recovery Color' =
			
			VAR Growth =
			    [OECD VC Recovery 2023-2025 (%)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Growth ), "#CBD5E1",
			        Growth > 0, "#2251FF",
			        Growth < 0, "#C4425C",
			        "#64748B"
			    )
		lineageTag: a77909a8-db00-4b81-896a-6a06f67c3aca

	column Placeholder
